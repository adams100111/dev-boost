# ~/.bashrc — dev-boost managed interactive shell configuration.
# devboost — managed by chezmoi; edit via dotfiles/dot_bashrc in the dev-boost repo.
# Do not edit this file manually; re-run `devboost install dotfiles` to reapply.

# If not running interactively, don't do anything.
[[ $- != *i* ]] && return

# The actual configuration lives in a sourceable fragment so a distro that owns
# ~/.bashrc itself (Omarchy) can pick up exactly the same setup by sourcing it.
[[ -r "${HOME}/.config/devboost/shell.bash" ]] && source "${HOME}/.config/devboost/shell.bash"
