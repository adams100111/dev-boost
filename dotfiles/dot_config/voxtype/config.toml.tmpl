{{- /* devboost — managed by chezmoi. One Voxtype config for every OS (spec §2). */ -}}
{{- $arabic := stat (joinPath .chezmoi.homeDir ".config/devboost/voxtype-arabic") -}}
# devboost — managed by chezmoi (dotfiles/dot_config/voxtype/config.toml.tmpl)
# Voxtype push-to-talk dictation — https://github.com/peteonrails/voxtype (docs/CONFIGURATION.md)
# Edit the template in the dev-boost repo, then run: devboost install dotfiles

engine = "whisper"

[hotkey]
# Hold the key, speak, release.
#
# macOS: Right Option. Upstream defaults to Globe/fn, but macOS already binds that to
# the emoji picker and system dictation. Left Option types accented characters, so it is
# not free either. Right Option produces nothing on its own — the only modifier on the
# keyboard that collides with nothing.
#
# Linux: Scroll Lock. Present on the evdev layer of most keyboards, and no desktop
# environment binds it.
#
# To use a different key, change it here and run `devboost install dotfiles`. Linux takes
# evdev names (SCROLLLOCK, PAUSE, F13, …); macOS takes RIGHTALT, FN, F13 … and ignores
# `modifiers` entirely, so a macOS hotkey must be a single key.
{{- if eq .chezmoi.os "darwin" }}
key = "RIGHTALT"
{{- else }}
key = "SCROLLLOCK"
{{- end }}
mode = "push_to_talk"
{{- if and $arabic (ne .chezmoi.os "darwin") }}
# voxtype-arabic: hold Left Shift with the hotkey to dictate with the Arabic model.
model_modifier = "LEFTSHIFT"
{{- end }}

[whisper]
model = "small.en"
{{- if $arabic }}
# voxtype-arabic: large-v3-turbo loads only when asked for (macOS: Ctrl+Alt+D, bound in
# the AeroSpace config) and is evicted after 60 s idle — no RAM between Arabic dictations.
language = ["en", "ar"]
secondary_model = "large-v3-turbo"
cold_model_timeout_secs = 60
{{- else }}
language = "en"
{{- end }}
